max-visible=5
layer=top
anchor=top-right

font=monospace 10
background-color=#1e1e2e
text-color=#cdd6f4
border-size=2
border-color=#89b4fa
border-radius=8
progress-color=source #313244

margin=10
padding=15
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark

markup=1
format=<b>%s</b>\n%b
default-timeout=5000
ignore-timeout=0

[urgency=low]
border-color=#a6e3a1
default-timeout=3000

[urgency=high]
border-color=#f38ba8
default-timeout=0
